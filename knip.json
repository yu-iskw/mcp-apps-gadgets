{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs", "tests/e2e/*.ts"],
      "project": ["**/*.{js,cjs,mjs,ts,cts,mts}", "!packages/**", "!.trunk/**", "!node_modules/**"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/gadget-host": {
      "entry": ["src/main.ts", "src/sandbox.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/demo-mcp-app": {
      "entry": ["main.ts", "server.ts", "src/app.ts"],
      "project": ["**/*.ts"]
    }
  }
}
